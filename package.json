{
  "name": "cup-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CUP backend - Phase 0 (Poster API -> CUP Backend -> Database -> Orders)",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate:prod": "node scripts/generate-production-schema.js && prisma generate --schema=prisma/postgres/schema.prisma",
    "prisma:migrate:prod": "node scripts/generate-production-schema.js && prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "prisma:validate:prod": "node scripts/generate-production-schema.js && prisma validate --schema=prisma/postgres/schema.prisma",
    "render:build": "npm ci && npm run prisma:generate:prod && tsc -p tsconfig.json",
    "render:start": "npm run prisma:migrate:prod && node dist/src/main.js",
    "seed": "ts-node prisma/seed.ts",
    "pretest": "node test/prepare-test-db.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=test/unit",
    "test:integration": "jest --runInBand --testPathPattern=test/integration"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^4.29.1",
    "grammy": "^1.46.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "nock": "^14.0.17",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
