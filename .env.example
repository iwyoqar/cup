# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# SQLite for local development (matches prisma/schema.prisma). Production (Render + Supabase) uses PostgreSQL instead, via
# the generated prisma/postgres/schema.prisma — see PROJECT_STATE.md's Phase 24 section for the exact production DATABASE_URL
# shape (Supabase's connection-pooling URL, port 6543, ?pgbouncer=true) and how it differs from this local value. Never point
# this local .env at the production Supabase database.
DATABASE_URL="file:./dev.db"

POSTER_API_BASE_URL="https://joinposter.com/api"
# Poster Personal Integration token. NEVER hardcode, log, or commit this value.
POSTER_API_TOKEN="replace-with-real-poster-token"
# Verified test value in the current Poster test account.
POSTER_DEFAULT_SPOT_ID=1

ORDER_STATUS_POLL_INTERVAL_MS=30000
CATALOG_SYNC_INTERVAL_MS=300000

# An IdempotencyKey left "in_progress" longer than this is treated as "uncertain" (never
# retried automatically against Poster) instead of blocking that key forever.
IDEMPOTENCY_STALE_IN_PROGRESS_MS=120000

# Telegram Bot API token from @BotFather. Phase 1.3 uses this as HMAC key material to verify
# Mini App initData; Phase 1.6 also uses it to run the actual bot (long polling in dev).
# NEVER hardcode, log, or commit this value.
TELEGRAM_BOT_TOKEN="replace-with-real-bot-token-from-botfather"
# Signs CUP's own session tokens. Generate a long random value, e.g. `openssl rand -hex 48`.
# Deliberately separate from the bot token and the Poster token. NEVER commit this value.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS=86400
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# A cart whose last activity is older than this is rejected at checkout (no background
# cleanup job — enforced only when checkout actually reads the cart).
CART_EXPIRY_MS=3600000

# Phase 1.6: the Telegram Mini App launch button's target. OPTIONAL — leave unset in
# development and the bot still fully registers customers and collects phone numbers; it
# just tells the user the Mini App isn't configured yet instead of showing the button.
# MINI_APP_URL="https://your-mini-app.example.com"

# Phase 3: signs Admin session tokens. Deliberately a SEPARATE secret from JWT_SECRET (customer
# sessions) — an admin token must never verify against a customer route or vice versa. Generate
# a long random value, e.g. `openssl rand -hex 48`. NEVER commit this value.
ADMIN_JWT_SECRET="replace-with-a-different-long-random-secret"
ADMIN_JWT_EXPIRES_IN_SECONDS=43200

# Phase 3: OPTIONAL, read only by `npm run seed` to idempotently create the first Admin row
# (upsert by email) when none exists yet. Not read by the running application. Leave unset
# after the first admin exists.
# ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-strong-password"

# Phase 13 — CRM automation. HARD SAFETY INTERLOCK: no automation can send a Telegram message unless this is exactly "true" (it also needs the
# Admin switch crm.automation.enabled). Leave it false/unset until you have reviewed the automations in Admin > CRM Automation (Preview).
# CRM_AUTOMATION_SEND_ENABLED=false
# How often the automation runner wakes up (it does nothing while either gate is closed). Default 60000.
# AUTOMATION_RUN_INTERVAL_MS=60000

# Phase 14 — referrals. The qualification / reward job heartbeat (it does nothing while Referrals is switched off in Admin > Referrals).
# REFERRAL_RUN_INTERVAL_MS=60000
# Optional: override the bot username used to build referral links (https://t.me/<username>?start=ref_<code>). When unset, the username the
# bot reports when it starts polling is used.
# TELEGRAM_BOT_USERNAME=

# Phase 20 — Poster webhook continuous sync. Ships OFF. To activate (see PROJECT_STATE.md "Phase 20 — activation steps"):
#   1. POSTER_APPLICATION_SECRET = the secret of your Poster application (Poster developer dashboard). Used ONLY to verify webhook signatures.
#      While it is unset, POST /webhooks/poster answers 503 and stores nothing.
#   2. POSTER_SYNC_ENABLED=true  — the operator interlock: nothing is fetched or imported (and the reconciliation loop does not run) unless it is exactly "true".
# POSTER_APPLICATION_SECRET=
# POSTER_SYNC_ENABLED=false
# Optional: pin the expected Poster account name (the "account" field of every webhook).
# POSTER_ACCOUNT=
# Queue processor tick (ms, default 15000); missed-webhook reconciliation interval (ms, default 600000) and lookback (days, 1-7, default 2);
# failed-attempt limit before an event is DEAD (default 12). A receipt is imported after POSTER_IMPORT_SETTLE_SECONDS (default 600) have passed since it closed.
# POSTER_SYNC_TICK_MS=15000
# POSTER_RECONCILE_INTERVAL_MS=600000
# POSTER_RECONCILE_LOOKBACK_DAYS=2   # ONLY the initial checkpoint (how far back the very first reconciliation looks); afterwards the durable checkpoint decides
# POSTER_RECONCILE_OVERLAP_MINUTES=60   # safety margin re-read before the checkpoint on every pass (5-1440)
# POSTER_WEBHOOK_MAX_ATTEMPTS=12

# Phase 21 — Poster POS widget backend (READ-ONLY). Ships OFF. To try it, see docs/PHASE-21-POS-CAPABILITY.md section 15.
# POS_WIDGET_ENABLED is an operator interlock: anything but exactly "true" makes every /pos-widget/* answer 503.
#   Poster signs the requests its servers proxy for the widget; the backend verifies that signature with POSTER_APPLICATION_SECRET (same secret as Phase 20; server-side only,
#   never in the widget bundle). The signature covers the FULL URL, so POS_WIDGET_PUBLIC_URL must be exactly the public HTTPS base URL Poster calls.
# POS_WIDGET_ENABLED=false
# POS_WIDGET_ACCOUNT=iwyoqar                    # the Poster account subdomain to accept (X-Poster-Url); unset while enabled -> 503 NOT_CONFIGURED
# POS_WIDGET_PUBLIC_URL=https://your-cup-backend.example
# POS_WIDGET_SIGNATURE_MAX_AGE=300              # accepted age of X-Poster-Time in seconds (30-3600)
# The widget itself (pos-widget/) is built with VITE_CUP_API_URL=<the same public URL> — the only value baked into bundle.js.

# Phase 22 — reward/promotion redemption on top of the Phase 21 widget. Both interlocks are INDEPENDENT of POS_WIDGET_ENABLED and of each other, and
#   both default to false. Turning POS_REWARD_REDEMPTION_ENABLED on does NOT by itself let a redemption succeed: no verified-safe Poster mutation
#   mechanism exists yet (see docs/PHASE-22-AUDIT.md and PROJECT_STATE.md) — every redemption attempt today still resolves to FAILED
#   BLOCKED_NO_VERIFIED_POSTER_MUTATION, and no reward is ever consumed. Do not enable in production without re-reading that limitation.
# POS_REWARD_REDEMPTION_ENABLED=false
# POS_PROMOTION_REDEMPTION_ENABLED=false        # promotion redemption is not implemented at all yet (flag reserved, unused)
