# The ONLY configuration baked into bundle.js: the PUBLIC HTTPS base URL of the CUP backend that Poster's servers call (Poster.makeRequest is proxied by Poster).
# Never put a secret here. Development can use a tunnel; production must be a stable domain (the bundle is cached at the register and only changes on re-upload).
VITE_CUP_API_URL=https://your-cup-backend.example
