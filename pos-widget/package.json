{
  "name": "cup-pos-widget",
  "version": "0.1.0",
  "private": true,
  "description": "CUP POS widget (Phase 21): a READ-ONLY Poster POS platform plugin. Builds ONE bundle.js (IIFE, CSS injected). Contains no secret; the only configuration is the public CUP API base URL.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "simulator": "node simulator/server.mjs",
    "serve": "node scripts/serve-dev.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
