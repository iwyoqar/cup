# Copy to .env and fill in real values for local dev. Never commit .env.
# Both values here are PUBLIC frontend configuration only — never put secrets
# (bot token, JWT secret, Poster token) in this file or anywhere in the frontend.

# Base URL of the CUP backend API. Must be reachable over HTTPS from Telegram clients in
# production; localhost is fine only for local dev in a desktop browser (not inside real
# Telegram, which cannot reach your machine's localhost).
VITE_API_BASE_URL="http://localhost:3000"
