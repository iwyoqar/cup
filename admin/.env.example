# Copy to .env and fill in real values for local dev. Never commit .env.
# Public frontend configuration only — never put secrets here.

# Base URL of the CUP backend API. localhost is fine for local dev; production must be the real
# deployed backend's HTTPS URL (e.g. the Render service URL), set at BUILD time (Vite bakes this
# in — changing it later requires a rebuild + redeploy of this app, not just an env var change).
VITE_API_BASE_URL="http://localhost:3000"
